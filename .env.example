# Neoxr API key (jangan di-commit / jangan taruh di frontend)
API_KEY=isi_apikey_neoxr
# Base URL API. Bot lama pakai https://api.neoxr.my.id/api ; ganti sesuai dokumentasi api.neoxr.eu
NEOXR_BASE=https://api.neoxr.eu/api
# Opsional: base cadangan bila NEOXR_BASE membalas non-JSON. Default .my.id; isi "off" untuk mematikan.
NEOXR_FALLBACK=
PORT=3000
# Secret untuk menandatangani link download (isi string acak panjang)
SIGN_SECRET=ganti-dengan-random-panjang
# Batas request per IP per menit
RATE_LIMIT=20
# Isi 1 jika di belakang nginx/cloudflare agar rate limit pakai X-Forwarded-For
TRUST_PROXY=
# Opsional: 'proxy' (stream via server) atau 'redirect' (302 ke sumber). Otomatis 'redirect' di Vercel.
FILE_MODE=
